# Cloudflare Pages deploy (GitHub Actions secrets — never commit the token).
# CLOUDFLARE_API_TOKEN: Account → Cloudflare Pages → Edit (and Workers Scripts Edit if using wrangler deploy).
# CLOUDFLARE_ACCOUNT_ID: Workers & Pages overview → Account ID.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional — required to sync APKs from private GitHub repos and Founder Bridge GitHub stats.
# Also used by lock-catalog-repos (classic PAT with `repo` scope).
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Play upload (see docs/google-play-setup.md)
# PLAY_SERVICE_ACCOUNT_JSON=secrets/play-service-account.json
# MBC_UPLOAD_KEYSTORE_PASSWORD=
# MBC_UPLOAD_KEY_PASSWORD=

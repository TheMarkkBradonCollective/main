{
  "name": "the-markk-brandon-collective",
  "private": true,
  "version": "2.0.0",
  "description": "MBC Store — mobile app store PWA for Markk Brandon Collective Android apps (catalog-driven APK downloads)",
  "homepage": "https://mbc-store.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMarkkBradonCollective/main.git"
  },
  "type": "module",
  "scripts": {
    "update": "node scripts/update.mjs",
    "process-brand": "node scripts/process-brand-assets.mjs",
    "sync-app-icons": "node scripts/sync-app-icons.mjs",
    "sync-classifieds": "node scripts/sync-classifieds.mjs",
    "sync-apk-catalog": "node scripts/sync-apk-catalog.mjs",
    "mirror-all-apks": "MIRROR_ALL_APKS=1 node scripts/sync-apk-catalog.mjs",
    "lock-catalog-repos": "node scripts/lock-catalog-repos.mjs",
    "lock-unlisted-repos": "node scripts/lock-unlisted-repos.mjs",
    "package-apk-release": "node scripts/package-apk-release.mjs",
    "build-mbc-store-apk": "node scripts/build-mbc-store-apk.mjs",
    "package-mbc-store-zip": "node scripts/package-mbc-store-zip.mjs",
    "package-verse-zip": "node scripts/package-verse-zip.mjs",
    "refresh-apk-downloads": "node scripts/refresh-apk-downloads.mjs",
    "publish-apk-release": "bash scripts/publish-apk-release.sh",
    "sync-founder-bridge": "node scripts/sync-founder-bridge.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "capture-screenshots": "node scripts/capture-app-screenshots.mjs",
    "capture-device-screenshots": "node scripts/capture-device-screenshots.mjs",
    "play:sync-apps": "node scripts/play/sync-play-apps.mjs",
    "play:scaffold": "node scripts/play/scaffold-repo-aab.mjs",
    "play:build": "node scripts/play/build-aab.mjs",
    "play:build:all": "node scripts/play/build-aab.mjs --sync --all",
    "play:upload": "node scripts/play/upload-to-play.mjs",
    "play:upload:all": "node scripts/play/upload-to-play.mjs --all"
  },
  "devDependencies": {
    "googleapis": "^144.0.0",
    "playwright": "^1.49.0",
    "sharp": "^0.34.3"
  }
}
